import random, math
group = [] #each element represents a person and stores 'True' if the person knows the rumour.
last_set = [] #this stores the index (in the list 'group') of whoever knows the rumour.
avg = 0

N = int(input("Enter the number of people in the group: "))
repeat_run = int(input("How many times should this program be run? "))


def new_day(): #this function allows the rumour to spread each day
    global rumour
    for i in range(rumour):
        next_person = random.randint(0, len(group) - 1)
        while next_person == last_set[i]:
            next_person = random.randint(0, len(group) - 1)
        if group[next_person] == False:
            last_set.append(next_person)
            group[next_person] = True
    rumour = group.count(True)

def reset(): #this resets all the variables and lists necessary to their initial states
     global rumour, day
     group.clear()
     last_set.clear()
     day = 1
     rumour = 1
     for r in range(N):
          group.append(False)
     first_person = random.randint(0, len(group) - 1)
     group[first_person] = True
     last_set.append(first_person)

def run_program(): #this function runs one cycle of spreading the rumour until everybody knows it
    global avg, day
    reset()
    #print(f"Today is day {day}. The rumour is invented by 1 person.")
    while rumour < N:
         day += 1
         new_day()
         #print(f"Today is day {day}. The rumour is known by {rumour} people.")
    avg += day
    #print(f"It took {day} days for the rumour to spread to {N} people in Run {z}.")


for z in range(1,repeat_run+1): #this loop allows the run_program function play as many times as requested
     #print()
     #print(f"\033[1mRun {z}\033[0m")
     run_program()

avg /= repeat_run
print()
print(f"It takes an average of {avg} days for an entire group of {N} people to learn a rumour.")
if avg != avg//1:
     print(f"That is essentially {math.ceil(avg)} days.")
